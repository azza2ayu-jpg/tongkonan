 $('layers').onchange=e=>{on[e.target.dataset.l]=e.target.checked;updVis()};
 $('e').oninput=e=>tgt.e=+e.target.value;$('eb').oninput=e=>tgt.b=+e.target.value;$('ef').oninput=e=>tgt.f=+e.target.value;
 $('el').oninput=e=>tgt.l=+e.target.value;
 const setState=()=>{const s=$('state').value;iso=s=='ins'?+$('iso').value:-1;tgt.e=s=='asm'?0:s=='exp'?1.8:s=='split'?1.5:1.2;tgt.s=s=='split'?2.2:0;tgt.l=s=='exp'||s=='ins'?.8:0;tgt.b=s=='exp'?1.2:0;tgt.f=s=='exp'?.8:0;
  $('e').value=tgt.e;$('el').value=tgt.l;$('eb').value=tgt.b;$('ef').value=tgt.f;if(s=='jnt'){openJoint(jtype);jexT=1}updVis()};
 $('state').onchange=$('iso').onchange=setState;
 $('mode').onchange=e=>{mode=e.target.value;if(mode=='sys'){tgt.e=1.5;$('e').value=1.5}setMats()};
 $('clip').onchange=e=>{const v=e.target.value;rend.clippingPlanes=v?[clipPl]:[];if(v)clipPl.normal.set(v=='z'?0:-1,0,v=='z'?-1:0)};
 $('lp').onchange=e=>{lpOn=e.target.checked;lpG.visible=lpOn;$('lpt').style.display=lpOn?'block':'none';setMats()};
 $('next').onclick=()=>setStage(stage+1);$('prev').onclick=()=>setStage(stage-1);
 $('rst').onclick=()=>{stopPlay();setStage(0)};
 $('play').onclick=()=>{if(timer){stopPlay();return}$('play').textContent='Pause';if(stage>=7)setStage(0);timer=setInterval(()=>{if(stage>=7)stopPlay();else setStage(stage+1)},1800)};
 $('par').innerHTML='<div class="note">Geometry is imported from the supplied <b>3d.glb</b> (236 SketchUp instances, 60 unique meshes, 6,338 triangles). Overall size about 18.6 × 5.4 × 14.8 model units. Component classes are inferred from material, position and shape; joint details too small to resolve are not reconstructed.</div>';
 $('jbt').innerHTML=Object.keys(JT).map(k=>'<button data-j="'+k+'">'+JT[k][2]+'</button>').join('');
 $('jbt').onclick=e=>e.target.dataset.j&&buildJoint(e.target.dataset.j);
 $('jx').innerHTML='<button id="jE">Explode joint</button><button id="jF">Remove fastener</button><button id="jC">Close</button>';
 $('jE').onclick=()=>jexT=jexT?0:1;$('jF').onclick=()=>fastOn=!fastOn;$('jC').onclick=()=>{jopen=false;$('jbar').style.display=$('jv').style.display='none'};
 // click (not drag) to pick a component
 const rc=new THREE.Raycaster(),dn={};rend.domElement.onpointerdown=e=>{dn.x=e.clientX;dn.y=e.clientY};
 rend.domElement.onpointerup=e=>{if(Math.hypot(e.clientX-dn.x,e.clientY-dn.y)>4)return;rc.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1),cam);
  const h=rc.intersectObjects(meshes.filter(m=>m.visible),false);if(h.length)select(h[0].object)};
 addEventListener('resize',()=>{rend.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()});
 build();view('iso');$('load').style.display='none';requestAnimationFrame(loop)}
try{if(!window.THREE||!THREE.OrbitControls)throw new Error('Three.js did not load (network access to cdn.jsdelivr.net is required).');init()}
catch(err){$('load').textContent='Error: '+err.message;console.error(err)}
</script></body></html>
